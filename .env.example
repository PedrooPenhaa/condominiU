# Domínio principal. Cada condomínio fica em <slug>.BASE_DOMAIN e seu painel em admin.BASE_DOMAIN
BASE_DOMAIN=minhagestora.com.br
BRAND_NAME=Minha Gestora

# Conexão usada pelo sistema: papel condo_app, sem permissão de ignorar o isolamento
# No Supabase, use o pooler em modo transação (porta 6543) e o usuário condo_app.REF_DO_PROJETO
DATABASE_URL=postgres://condo_app:SENHA@HOST:5432/postgres
# Conexão usada só nas migrações: papel dono do banco
DATABASE_ADMIN_URL=postgres://postgres:SENHA@HOST:5432/postgres

# Máximo de conexões por instância. Na Vercel, use 2
DB_POOL_MAX=5
# Certificado raiz do banco, em uma linha com \n no lugar das quebras. Baixe no painel do Supabase
DB_SSL_CA=

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Protege a rota de rotinas. Gere um valor aleatório longo
JOBS_SECRET=
# Na Vercel, use o mesmo valor de JOBS_SECRET: a rotina diária envia este segredo
CRON_SECRET=

# sandbox ou production
ASAAS_ENV=sandbox
# Chave da SUA conta Asaas (a conta-pai, com CNPJ)
ASAAS_API_KEY=
# Sua carteira, usada para receber split. Consulte em GET /v3/wallets
ASAAS_WALLET_ID=
# Token que você define ao criar o webhook da sua conta. De 32 a 255 caracteres
ASAAS_WEBHOOK_TOKEN=

# Coloque 1 só atrás de um proxy confiável, como a Vercel
TRUST_PROXY=1
NODE_ENV=production
PORT=3000
