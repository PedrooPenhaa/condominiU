{
  "name": "condo-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "start": "tsx --env-file-if-exists=.env src/server/main.ts",
    "dev": "tsx scripts/build.ts && tsx --env-file-if-exists=.env src/server/main.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "create-admin": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "fake-asaas": "tsx scripts/fake-asaas.ts",
    "demo": "tsx scripts/build.ts && tsx scripts/demo.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0"
  }
}
